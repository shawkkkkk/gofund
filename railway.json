{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm audit --omit=dev --json || true; npm run typecheck && npm run build",
    "watchPatterns": [
      "src/**",
      "db/**",
      "scripts/**",
      "package.json",
      "next.config.ts",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "preDeployCommand": [
      "npm run db:migrate"
    ],
    "healthcheckPath": "/api/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "overlapSeconds": "20",
    "drainingSeconds": "10"
  }
}
