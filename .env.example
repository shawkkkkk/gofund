# Public app origin used in immutable Pump metadata URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana mainnet RPC. Use a production RPC provider before launch.
# Dedicated/private Solana mainnet RPC. Kept server-side; the browser uses /api/rpc.
SOLANA_RPC_URL=

# GoFund treasury that receives 100% of each locked token's creator-fee distribution.
NEXT_PUBLIC_GOFUND_TREASURY=
GOFUND_TREASURY=

# PostgreSQL database.
DATABASE_URL=

# Separate hot wallet used only to pay gas for permissionless fee distributions.
# JSON array of 64 secret-key bytes. Do NOT use the treasury key here.
FEE_PAYER_SECRET_KEY=

# Protects internal worker/admin endpoints.
INTERNAL_API_SECRET=

# In-process worker loop. Railway runs a persistent Node process with sleep disabled.
WORKER_ENABLED=false
WORKER_INTERVAL_MS=60000

# Global mainnet launch kill switch. Keep false until treasury/RPC/legal ops are ready.
LAUNCH_ENABLED=false

# Readiness requires at least this many lamports in the automation gas wallet.
# Default 10,000,000 lamports = 0.01 SOL.
MIN_FEE_PAYER_LAMPORTS=10000000
